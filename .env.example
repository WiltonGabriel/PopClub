# ==============================================================================
# Pop Shake Sorveteria — Exemplo de Variáveis de Ambiente
# ==============================================================================

# Google Maps Platform API Key (Geocodificação Reversa e Autocompletação)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=sua_chave_google_maps_aqui

# Conexão com Banco de Dados PostgreSQL (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/popclub?schema=public"

# Chave Secreta para Assinatura de Sessões e Tokens JWT
JWT_SECRET="sua_chave_jwt_secreta_minimo_32_caracteres"

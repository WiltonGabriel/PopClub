# ==============================================================================
# PopClub (Pop Shake Sorveteria) — Arquivo de Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env ou .env.local: cp .env.example .env
# ==============================================================================

# 1. Conexão com o Banco de Dados PostgreSQL (Prisma ORM)
# Opção A (Ambiente Local Isolado via Docker):
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/popclub?schema=public"

# Opção B (Ambiente de Produção/Staging Centralizado via Tailscale VPN):
# DATABASE_URL="postgresql://postgres:SUA_SENHA_AQUI@SEU_IP_VPS_OU_VPN:5432/popclub?schema=public"

# 2. Segurança e Autenticação (JWT e Sessões HttpOnly)
# Gere uma string aleatória segura de pelo menos 32 caracteres:
JWT_SECRET="sua_chave_secreta_jwt_de_desenvolvimento_popclub_2026_minimo_32_caracteres"

# 3. Identidade da Loja e Atendimento (Opcional - Valores Padrão já Embutidos)
NEXT_PUBLIC_STORE_NAME="Pop Shake Sorveteria"
NEXT_PUBLIC_STORE_PHONE="5565999999999"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  client
  admin
}

enum DiscountType {
  percentage
  fixed
}

enum OrderStatus {
  pending
  accepted
  preparing
  ready
  delivering
  completed
  cancelled
}

enum PaymentMethodType {
  dinheiro
  cartao_maquininha
  pix_entrega
}

model User {
  id               String         @id @default(uuid())
  username         String         @unique
  email            String         @unique
  passwordHash     String         @map("password_hash")
  role             Role           @default(client)
  fullName         String?        @map("full_name")
  avatarUrl        String?        @map("avatar_url")
  phone            String?
  resetCode        String?        @map("reset_code")
  resetCodeExpires DateTime?      @map("reset_code_expires")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  locations        UserLocation[]
  orders           Order[]

  @@map("users")
}

model UserLocation {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String?
  addressLine String   @map("address_line")
  latitude    Float
  longitude   Float
  accuracy    Float?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_locations")
}

model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String?   @unique
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@map("categories")
}

model Product {
  id             String          @id @default(uuid())
  name           String
  description    String?
  price          Decimal         @db.Decimal(10, 2)
  categoryId     String?         @map("category_id")
  category       String?
  imageUrl       String?         @map("image_url")
  createdAt      DateTime        @default(now()) @map("created_at")
  categoryRel    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  promotionItems PromotionItem[]
  orderItems     OrderItem[]

  @@map("products")
}

model Promotion {
  id             String          @id @default(uuid())
  title          String
  badge          String
  description    String?
  bannerImageUrl String?         @map("banner_image_url")
  gradientStart  String          @default("#9306CF") @map("gradient_start")
  gradientEnd    String          @default("#881BAA") @map("gradient_end")
  discountType   DiscountType    @default(percentage) @map("discount_type")
  discountValue  Decimal         @default(0) @db.Decimal(10, 2) @map("discount_value")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  items          PromotionItem[]

  @@map("promotions")
}

model PromotionItem {
  id          String    @id @default(uuid())
  promotionId String    @map("promotion_id")
  productId   String    @map("product_id")
  quantity    Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("promotion_items")
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @db.Decimal(10, 2) @map("discount_value")
  minOrderValue Decimal      @default(0) @db.Decimal(10, 2) @map("min_order_value")
  maxUses       Int?         @map("max_uses")
  uses          Int          @default(0)
  expiresAt     DateTime?    @map("expires_at")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  orders        Order[]

  @@map("coupons")
}

model Order {
  id                   String            @id @default(uuid())
  userId               String?           @map("user_id")
  status               OrderStatus       @default(pending)
  subtotal             Decimal           @db.Decimal(10, 2)
  discountAmount       Decimal           @default(0) @db.Decimal(10, 2) @map("discount_amount")
  totalAmount          Decimal           @db.Decimal(10, 2) @map("total_amount")
  couponId             String?           @map("coupon_id")
  couponCode           String?           @map("coupon_code")
  paymentMethodType    PaymentMethodType @default(dinheiro) @map("payment_method_type")
  paymentChangeFor     Decimal?          @db.Decimal(10, 2) @map("payment_change_for")
  deliveryStreet       String            @map("delivery_street")
  deliveryNumber       String            @map("delivery_number")
  deliveryNeighborhood String            @map("delivery_neighborhood")
  deliveryCity         String            @default("Local") @map("delivery_city")
  deliveryComplement   String?           @map("delivery_complement")
  deliveryReference    String?           @map("delivery_reference")
  deliveryZip          String?           @map("delivery_zip")
  deliveryLatitude     Float?            @map("delivery_latitude")
  deliveryLongitude    Float?            @map("delivery_longitude")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  user                 User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon               Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items                OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  productId   String   @map("product_id")
  quantity    Int      @default(1)
  priceAtTime Decimal  @db.Decimal(10, 2) @map("price_at_time")
  promotionId String?  @map("promotion_id")
  createdAt   DateTime @default(now()) @map("created_at")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

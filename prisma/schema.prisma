datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CLIENT @map("client")
  ADMIN  @map("admin")
  EDITOR @map("editor")
}

enum DiscountType {
  percentage
  fixed
}

enum OrderStatus {
  pending
  accepted
  preparing
  ready
  delivering
  completed
  cancelled
}

enum PaymentMethodType {
  dinheiro
  cartao_maquininha
  pix_entrega
}

model CustomRole {
  id          String   @id @default(uuid())
  name        String   @unique
  color       String   @default("blue")
  permissions String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  users       User[]

  @@map("custom_roles")
}

model User {
  id                    String             @id @default(uuid())
  cpf                   String?            @unique
  username              String?            @unique
  email                 String?            @unique
  googleId              String?            @unique @map("google_id")
  emailVerified         Boolean            @default(false) @map("email_verified")
  emailVerificationCode String?            @map("email_verification_code")
  emailVerificationExpires DateTime?       @map("email_verification_expires")
  passwordHash          String?            @map("password_hash")
  role                  Role               @default(CLIENT)
  permissions           String[]           @default([])
  isActive              Boolean            @default(true) @map("is_active")
  isBlocked             Boolean            @default(false) @map("is_blocked")
  blockReason           String?            @map("block_reason")
  tokenVersion          Int                @default(1) @map("token_version")
  deletedAt             DateTime?          @map("deleted_at")
  fullName              String?            @map("full_name")
  avatarUrl             String?            @default("/avatars/avatar-sorvete.svg") @map("avatar_url")
  accessibilitySettings Json?              @map("accessibility_settings")
  phone                 String?            @unique
  isRegistered          Boolean            @default(false) @map("is_registered")
  resetCode             String?            @map("reset_code")
  resetCodeExpires      DateTime?          @map("reset_code_expires")
  notificationsEnabled  Boolean            @default(true) @map("notifications_enabled")
  lastNameChangedAt     DateTime?          @map("last_name_changed_at")
  lastEmailChangedAt    DateTime?          @map("last_email_changed_at")
  lastPasswordChangedAt DateTime?          @map("last_password_changed_at")
  passwordUpdatedAt     DateTime?          @default(now()) @map("password_updated_at")
  recoveryRequestCount  Int                @default(0) @map("recovery_request_count")
  recoveryBlockedUntil  DateTime?          @map("recovery_blocked_until")
  customRoleId          String?            @map("custom_role_id")
  customRole            CustomRole?        @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  createdById           String?            @map("created_by_id")
  createdBy             User?              @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers          User[]             @relation("UserCreatedBy")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  locations             UserLocation[]
  orders                Order[]
  userNotifications     UserNotification[]
  couponRedemptions     CouponRedemption[]

  @@index([phone])
  @@index([cpf])
  @@index([customRoleId])
  @@map("users")
}

model UserLocation {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String?
  addressLine String?  @map("address_line")
  street      String   @default("")
  number      String   @default("")
  neighborhood String  @default("")
  city        String   @default("Várzea Grande")
  state       String   @default("MT")
  complement  String?
  reference   String?
  zip         String?
  latitude    Float?
  longitude   Float?
  accuracy    Float?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_locations")
}

model CustomAudienceList {
  id        String   @id @default(uuid())
  name      String
  userIds   String[] @default([]) @map("user_ids")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("custom_audience_lists")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?   @map("image_url")
  order       Int       @default(0)
  isActive    Boolean   @default(true) @map("is_active")
  isDynamic   Boolean   @default(false) @map("is_dynamic")
  dynamicType String?   @map("dynamic_type")
  timeStart   String?   @map("time_start")
  timeEnd     String?   @map("time_end")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @default(now()) @map("updated_at")
  products    Product[]

  @@map("categories")
}

model Product {
  id               String                 @id @default(uuid())
  name             String
  description      String?
  price            Decimal                @db.Decimal(10, 2)
  servesText       String?                @map("serves_text")
  isHighlight      Boolean                @default(false) @map("is_highlight")
  categoryId       String?                @map("category_id")
  category         String?
  imageUrl         String?                @map("image_url")
  stock            Int?
  isAvailable      Boolean                @default(true) @map("is_available")
  cardBadgeId      String?                @map("card_badge_id")
  createdAt        DateTime               @default(now()) @map("created_at")
  categoryRel      Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cardBadge        CardBadge?             @relation(fields: [cardBadgeId], references: [id], onDelete: SetNull)
  orderItems       OrderItem[]
  isCombo          Boolean                @default(false) @map("is_combo")
  promotions       Promotion[]
  comboItems       ComboItem[]            @relation("ComboParent")
  partOfCombos     ComboItem[]            @relation("ComboChild")
  addonGroups      ProductAddonGroup[]

  // Urgência e Escassez (Combos e Ofertas)
  showScarcity     Boolean                @default(false) @map("show_scarcity")
  scarcityType     String?                @default("strategic") @map("scarcity_type")
  scarcityUnits    Int?                   @map("scarcity_units")
  scarcityInitial  Int?                   @map("scarcity_initial")
  scarcitySold     Int                    @default(0) @map("scarcity_sold")
  showProgressBar  Boolean                @default(false) @map("show_progress_bar")
  showDuration     Boolean                @default(false) @map("show_duration")
  urgencyType      String?                @default("date") @map("urgency_type")
  expiresAt        DateTime?              @map("expires_at")
  sessionMinutes   Int?                   @map("session_minutes")

  @@map("products")
}

model AddonGroup {
  id           String              @id @default(uuid())
  name         String
  description  String?
  minQuantity  Int                 @default(0) @map("min_quantity")
  maxQuantity  Int                 @default(1) @map("max_quantity")
  freeQuantity Int                 @default(0) @map("free_quantity")
  isRequired        Boolean             @default(false) @map("is_required")
  allowItemQuantity Boolean             @default(false) @map("allow_item_quantity")
  sortOrder         Int                 @default(0) @map("sort_order")
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  items             AddonItem[]
  products          ProductAddonGroup[]

  @@map("addon_groups")
}

model AddonItem {
  id          String     @id @default(uuid())
  groupId     String     @map("group_id")
  name        String
  price       Decimal    @default(0) @db.Decimal(10, 2)
  imageUrl    String?    @map("image_url")
  isAvailable Boolean    @default(true) @map("is_available")
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  group       AddonGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("addon_items")
}

model ProductAddonGroup {
  id        String     @id @default(uuid())
  productId String     @map("product_id")
  groupId   String     @map("group_id")
  sortOrder Int        @default(0) @map("sort_order")
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     AddonGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([productId, groupId])
  @@map("product_addon_groups")
}

model Promotion {
  id             String          @id @default(uuid())
  title          String
  badge          String          @default("PROMO")
  description    String?
  bannerImageUrl String?         @map("banner_image_url")
  gradientStart  String          @default("#9306CF") @map("gradient_start")
  gradientEnd    String          @default("#881BAA") @map("gradient_end")
  discountType   DiscountType    @default(percentage) @map("discount_type")
  discountValue  Decimal         @default(0) @db.Decimal(10, 2) @map("discount_value")
  isActive       Boolean         @default(true) @map("is_active")
  
  // Vigência Temporal
  startsAt       DateTime        @default(now()) @map("starts_at")
  expiresAt      DateTime?       @map("expires_at")
  
  // Duração e Escassez (Marketing)
  showDuration    Boolean         @default(false) @map("show_duration")
  durationDisplay String[]        @default([]) @map("duration_display")
  autoBanner      Boolean         @default(false) @map("auto_banner")
  showScarcity    Boolean         @default(false) @map("show_scarcity")
  scarcityUnits   Int?            @map("scarcity_units")
  scarcityType    String?         @default("strategic") @map("scarcity_type")
  scarcityInitial Int?            @map("scarcity_initial")
  scarcitySold    Int             @default(0) @map("scarcity_sold")
  showProgressBar Boolean         @default(false) @map("show_progress_bar")
  urgencyType     String?         @default("date") @map("urgency_type")
  sessionMinutes  Int?            @map("session_minutes")

  productId      String          @map("product_id")
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([productId])
  @@map("promotions")
}

model ComboItem {
  id          String    @id @default(uuid())
  comboId     String    @map("combo_id")
  productId   String    @map("product_id")
  quantity    Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  combo       Product   @relation("ComboParent", fields: [comboId], references: [id], onDelete: Cascade)
  product     Product   @relation("ComboChild", fields: [productId], references: [id], onDelete: Cascade)

  @@map("combo_items")
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @db.Decimal(10, 2) @map("discount_value")
  minOrderValue Decimal      @default(0) @db.Decimal(10, 2) @map("min_order_value")
  maxUses       Int?         @map("max_uses")
  uses          Int          @default(0)
  expiresAt     DateTime?    @map("expires_at")
  isActive      Boolean        @default(true) @map("is_active")
  oncePerUser   Boolean        @default(false) @map("once_per_user")
  productIds    String[]       @default([]) @map("product_ids")
  minLoyaltyLevel Int?         @map("min_loyalty_level")
  loyaltyBadgeId  String?      @map("loyalty_badge_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  orders        Order[]
  notifications Notification[]
  redemptions   CouponRedemption[]

  @@map("coupons")
}

model Order {
  id                   String            @id @default(uuid())
  userId               String?           @map("user_id")
  status               OrderStatus       @default(pending)
  subtotal             Decimal           @db.Decimal(10, 2)
  discountAmount       Decimal           @default(0) @db.Decimal(10, 2) @map("discount_amount")
  deliveryFee          Decimal           @default(0) @db.Decimal(10, 2) @map("delivery_fee")
  totalAmount          Decimal           @db.Decimal(10, 2) @map("total_amount")
  couponId             String?           @map("coupon_id")
  couponCode           String?           @map("coupon_code")
  paymentMethodType    PaymentMethodType @default(dinheiro) @map("payment_method_type")
  paymentChangeFor     Decimal?          @db.Decimal(10, 2) @map("payment_change_for")
  changeFor            Decimal?          @db.Decimal(10, 2) @map("change_for")
  changeToReturn       Decimal?          @db.Decimal(10, 2) @map("change_to_return")
  deliveryStreet       String            @map("delivery_street")
  deliveryNumber       String            @map("delivery_number")
  deliveryNeighborhood String            @map("delivery_neighborhood")
  deliveryCity         String            @default("Local") @map("delivery_city")
  deliveryComplement   String?           @map("delivery_complement")
  deliveryReference    String?           @map("delivery_reference")
  deliveryZip          String?           @map("delivery_zip")
  deliveryLatitude     Float?            @map("delivery_latitude")
  deliveryLongitude    Float?            @map("delivery_longitude")
  originLatitude       Float?            @default(-15.6536) @map("origin_latitude")
  originLongitude      Float?            @default(-56.1322) @map("origin_longitude")
  originAddress        String?           @default("Várzea Grande, MT") @map("origin_address")
  branchId             String?           @default("store_config") @map("branch_id")
  cancellationReason   String?           @map("cancellation_reason")
  cancelledAt          DateTime?         @map("cancelled_at")
  shiftId              String?           @map("shift_id")
  idempotencyKey       String?           @unique @map("idempotency_key")
  isArchived           Boolean           @default(false) @map("is_archived")
  trackingToken        String?           @unique @map("tracking_token")
  isGpsTrackingActive  Boolean           @default(false) @map("is_gps_tracking_active")
  courierLatitude      Float?            @map("courier_latitude")
  courierLongitude     Float?            @map("courier_longitude")
  courierUpdatedAt     DateTime?         @map("courier_updated_at")
  courierName          String?           @map("courier_name")
  courierPhone         String?           @map("courier_phone")
  courierCode          String?           @map("courier_code")
  orderPin             String?           @map("order_pin")
  dispatchedAt         DateTime?         @map("dispatched_at")
  deliveredAt          DateTime?         @map("delivered_at")
  deliveryIssue        String?           @map("delivery_issue")
  deliveryIssueNotes   String?           @map("delivery_issue_notes")
  deliveryIssueAt      DateTime?         @map("delivery_issue_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  user                 User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon               Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items                OrderItem[]
  couponRedemptions    CouponRedemption[]

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  productId   String   @map("product_id")
  quantity    Int      @default(1)
  priceAtTime Decimal  @db.Decimal(10, 2) @map("price_at_time")
  promotionId String?  @map("promotion_id")
  selectedAddons Json? @map("selected_addons") // Historiza os addons pagos naquele momento
  notes       String?  @map("notes")
  createdAt   DateTime @default(now()) @map("created_at")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model HighlightBanner {
  id        String   @id @default("home_highlight")
  icon      String   @default("🥣")
  title     String   @default("Monte do seu jeito: escolha o tamanho e adicione seus acompanhamentos favoritos")
  subtitle  String   @default("Açaí puro batido na hora, cremoso e com acompanhamentos à sua escolha.")
  badge     String   @default("Refrescância Artesanal")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("highlight_banners")
}

model LoadingSettings {
  id               String   @id @default("global_loading")
  theme            String   @default("liquid_cream")
  centerIcon       String   @default("🥣") @map("center_icon")
  phrases          String[] @default(["Batendo o açaí artesanal na cremosidade perfeita...", "Separando os acompanhamentos mais fresquinhos...", "Preparando as receitas mais deliciosas do cardápio...", "Quase pronto! Seu momento doce está chegando..."])
  rotationInterval Int      @default(2400) @map("rotation_interval")
  minDuration      Int      @default(800) @map("min_duration")

  // Personalização de Fundo (Background da Aplicação)
  bgTypeLight      String   @default("gradient") @map("bg_type_light")
  bgValueLight     String   @default("preset_cream") @map("bg_value_light")
  bgCustomLight    String?  @default("#FBF8FD") @map("bg_custom_light")

  bgTypeDark       String   @default("gradient") @map("bg_type_dark")
  bgValueDark      String   @default("preset_dark_violet") @map("bg_value_dark")
  bgCustomDark     String?  @default("#190B1A") @map("bg_custom_dark")

  // Favicon Customizado
  faviconUrl       String?  @default("/favicon.ico") @map("favicon_url")

  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("loading_settings")
}

model StoreSettings {
  id                    String    @id @default("store_config")
  deliveryFee           Decimal   @default(5.00) @db.Decimal(10, 2) @map("delivery_fee")
  freeDeliveryThreshold Decimal?  @db.Decimal(10, 2) @map("free_delivery_threshold")
  whatsappNumber        String?   @default("5565999999999") @map("whatsapp_number")
  whatsappMessage       String?   @default("Olá! Gostaria de tirar uma dúvida sobre os pedidos da Pop Shake Sorveteria.") @map("whatsapp_message")
  isOpen                Boolean   @default(true) @map("is_open")
  currentShiftId        String?   @map("current_shift_id")
  estimatedDeliveryTime  String    @default("30-50 min") @map("estimated_delivery_time")
  estimatedTimePresets   String[]  @default(["20-30 min", "35-50 min", "50-70 min"]) @map("estimated_time_presets")
  rejectionReasonPresets String[]  @default(["Ingrediente/item do cardápio indisponível no momento", "Endereço fora da área de entrega atendida", "Pico de demanda: cozinha sobrecarregada temporariamente", "Estabelecimento em processo de fechamento de turno"]) @map("rejection_reason_presets")
  storeLatitude         Float?    @default(-15.6536) @map("store_latitude")
  storeLongitude        Float?    @default(-56.1322) @map("store_longitude")
  storeAddress          String?   @default("Várzea Grande, MT") @map("store_address")
  maxDeliveryRadiusKm   Float?    @default(10) @map("max_delivery_radius_km")
  businessHours         Json?     @map("business_hours")
  instagramUrl          String?   @default("https://instagram.com/popshake") @map("instagram_url")
  facebookUrl           String?   @map("facebook_url")
  supportPhone          String?   @map("support_phone")
  postSaleMessage       String?   @default("Obrigado pelo seu pedido no Pop Shake! Como foi sua experiência hoje? Avalie nosso atendimento e ganhe um cupom de desconto para o próximo pedido! 🍧") @map("post_sale_message")
  supportMessage        String?   @default("Olá! Preciso de ajuda com meu pedido no Pop Shake.") @map("support_message")
  openingHoursText      String?   @default("Terça a Domingo das 14h às 22h") @map("opening_hours_text")
  orderNotificationTemplates Json? @map("order_notification_templates")
  faviconUrl            String?   @default("/favicon.ico") @map("favicon_url")
  footerSlogan          String?   @default("Açaí artesanal, cremosidade única e o sabor que transforma o seu dia.") @map("footer_slogan")
  footerBadgeText       String?   @default("Delivery Próprio e Artesanal") @map("footer_badge_text")
  showPaymentMethods    Boolean   @default(true) @map("show_payment_methods")
  acceptedPayments      String[]  @default(["pix", "dinheiro", "credito", "debito"]) @map("accepted_payments")
  googleMapsUrl         String?   @map("google_maps_url")
  storeCnpj             String?   @map("store_cnpj")
  openedAt               DateTime? @map("opened_at")
  closedAt               DateTime? @map("closed_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("store_settings")
}

model Courier {
  id         String   @id @default(uuid())
  name       String
  phone      String
  vehicle    String?  @default("Moto")
  plate      String?
  pixKey     String?  @map("pix_key")
  status     String   @default("available") // "available", "in_transit", "off_duty"
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("couriers")
}

model Shift {
  id                    String    @id @default(uuid())
  code                  String    @unique
  openedAt              DateTime  @default(now()) @map("opened_at")
  closedAt              DateTime? @map("closed_at")
  isOpen                Boolean   @default(true) @map("is_open")
  estimatedDeliveryTime String?   @default("30-50 min") @map("estimated_delivery_time")
  totalRevenue          Decimal   @default(0) @db.Decimal(10, 2) @map("total_revenue")
  totalOrders           Int       @default(0) @map("total_orders")
  completedOrders       Int       @default(0) @map("completed_orders")
  cancelledOrders       Int       @default(0) @map("cancelled_orders")
  cashTotal             Decimal   @default(0) @db.Decimal(10, 2) @map("cash_total")
  pixTotal              Decimal   @default(0) @db.Decimal(10, 2) @map("pix_total")
  cardTotal             Decimal   @default(0) @db.Decimal(10, 2) @map("card_total")
  notes                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("shifts")
}

model CardBadge {
  id        String    @id @default(uuid())
  text      String
  icon      String?
  bgColor   String    @default("#FEF3C7") @map("bg_color")
  textColor String    @default("#B45309") @map("text_color")
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@map("card_badges")
}

model AvatarPreset {
  id          String   @id @default(cuid())
  name        String
  description String
  imageUrl    String   @map("image_url")
  category    String?  @default("Oficial")
  isActive    Boolean  @default(true) @map("is_active")
  order       Int      @default(0)
  minMonths   Int      @default(0) @map("min_months")
  minOrders   Int      @default(0) @map("min_orders")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("avatar_presets")
}

enum NotificationType {
  BROADCAST
  TARGETED
  COUPON
}

model Notification {
  id                String             @id @default(uuid())
  title             String
  message           String
  type              NotificationType   @default(BROADCAST)
  targetAudience    String             @default("ALL") @map("target_audience")
  couponId          String?            @map("coupon_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  coupon            Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  userNotifications UserNotification[]

  @@map("notifications")
}

model UserNotification {
  id             String       @id @default(uuid())
  userId         String       @map("user_id")
  notificationId String       @map("notification_id")
  isRead         Boolean      @default(false) @map("is_read")
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId, isRead])
  @@map("user_notifications")
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  title     String
  message   String
  category  String   @default("custom")
  couponId  String?  @map("coupon_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notification_templates")
}

model BackupMetadata {
  slot        Int      @id
  createdAt   DateTime @map("created_at")
  totalTables Int      @map("total_tables")
  totalRows   Int      @map("total_rows")
  details     Json?

  @@map("_backup_metadata")
}


model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String   @map("coupon_id")
  userId    String   @map("user_id")
  orderId   String?  @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([couponId, userId])
  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

model LoyaltyBadgeConfig {
  id           String   @id
  level        Int      @unique
  name         String
  icon         String   @default("🌟")
  minMonths    Int      @default(0) @map("min_months")
  minOrders    Int      @default(0) @map("min_orders")
  criteriaMode String   @default("either") @map("criteria_mode")
  description  String?
  badgeClass   String?  @map("badge_class")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("loyalty_badge_configs")
}

model AdminAuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?  @map("actor_user_id")
  actorRole    String   @map("actor_role")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  summary      String
  diffKeys     String[] @default([]) @map("diff_keys")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([actorUserId])
  @@index([resourceType, createdAt])
  @@index([createdAt])
  @@map("admin_audit_logs")
}
